# Root-level overrides for docker-compose. The backend reads backend/.env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
CORS_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:4000/api
