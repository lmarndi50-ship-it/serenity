# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Matches docker-compose.yml. Change the credentials for any real deployment.
DATABASE_URL="postgresql://cams:cams_dev_password@localhost:5432/cams?schema=public"

# ---- Auth ----
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-16-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS (comma-separated) ----
CORS_ORIGIN=http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---- Rate limiting ----
# Limits are per client IP. A whole campus can share one NAT address, so the
# general limit is generous; the credential limit is the one that matters and
# stays tight. Raise RATE_LIMIT_MAX further if students sit behind one gateway.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
