# HTTP + WebSocket port
PORT=4000

# Comma-separated list of origins allowed to call the API / open a WS
# connection (your frontend's dev and prod URLs). Use * only for local
# testing.
CORS_ORIGIN=http://localhost:5173

# Required header value (x-ingest-key) for POST /api/ingest/reading.
# Set this to a long random string before exposing the server publicly —
# this is the key your Arduino UNO Q (or any gateway relaying its data)
# must present to push real sensor readings.
INGEST_API_KEY=change-me-before-deploying

# How long (ms) a real hardware reading stays "fresh" before the server
# falls back to the simulator if no new ingest arrives.
HARDWARE_STALE_MS=30000
